--- a/src/jsd_epd_common_types.h
+++ b/src/jsd_epd_common_types.h
@@ -14,6 +14,14 @@ extern "C" {
 #define JSD_EPD_PRODUCT_CODE_STD_FW (uint32_t)0x00100002
 // Product code of Platinum drives that use the Safety firmware (FSOE, Safe I/O)
 #define JSD_EPD_PRODUCT_CODE_SAFETY_FW (uint32_t)0x01100002
+// Circle port: additional product code of a Platinum drive variant, which is
+// not known to JSD. Define it on the compiler command line, for example with
+// "make ELMO_EPD_PRODUCT_CODE=0x00900002". If it is not defined, it repeats a
