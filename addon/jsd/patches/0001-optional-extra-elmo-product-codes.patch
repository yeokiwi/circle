+// See addon/jsd/README of the Circle project.
+#ifndef JSD_EPD_PRODUCT_CODE_EXTRA
+#define JSD_EPD_PRODUCT_CODE_EXTRA JSD_EPD_PRODUCT_CODE_STD_FW
